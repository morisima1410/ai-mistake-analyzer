{
  "name": "ai-mistake-analyzer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "vite build && node -e \"const fs=require('fs'); fs.cpSync('js', 'dist/js', {recursive:true}); fs.cpSync('css', 'dist/css', {recursive:true});\"",
    "lint": "tsc --noEmit",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "start": "node server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.0"
  }
}
